// ════════════════════════════════════════════════════════════════════
// firestore.rules — Règles de sécurité Firestore
// À copier dans Firebase Console → Firestore → Rules
// ════════════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Collection contacts (formulaire site) ──────────────────────
    match /contacts/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['name','email','message','created_at','status']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 200 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.status == 'new';
      allow read, update, delete: if request.auth != null;
    }

    // ── Collection site_analytics (tracking visiteurs) ─────────────
    // Écriture publique limitée, lecture uniquement admin
    match /site_analytics/{docId} {
      allow create: if
        request.resource.data.keys().hasAny(['type','visitor_id','created_at_iso']) &&
        request.resource.data.type is string &&
        request.resource.data.type in ['visit','click'] &&
        request.resource.data.visitor_id is string &&
        request.resource.data.visitor_id.size() <= 60;
      // Mise à jour limitée à time_on_page uniquement (tracking durée)
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['time_on_page']) &&
        request.resource.data.time_on_page is int &&
        request.resource.data.time_on_page >= 0 &&
        request.resource.data.time_on_page <= 86400;
      allow read, delete: if request.auth != null;
    }

    // ── Tout le reste est refusé par défaut ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
